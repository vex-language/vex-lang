/// The n-body simulation of the Jovian planets: float math on struct fields.
import "vex:math"
import "vex:os"

const solarMass = 39.47841760435743
const daysPerYear = 365.24

/// A planet or the sun, with its position, velocity and mass.
struct Body {
    x: float
    y: float
    z: float
    vx: float
    vy: float
    vz: float
    mass: float
}

/// Returns the sun and the four outer planets.
fn system() -> [Body] {
    return [
        Body(x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solarMass),
        Body(
            x: 4.84143144246472090e+00, y: -1.16032004402742839e+00, z: -1.03622044471123109e-01,
            vx: 1.66007664274403694e-03 * daysPerYear, vy: 7.69901118419740425e-03 * daysPerYear,
            vz: -6.90460016972063023e-05 * daysPerYear, mass: 9.54791938424326609e-04 * solarMass),
        Body(
            x: 8.34336671824457987e+00, y: 4.12479856412430479e+00, z: -4.03523417114321381e-01,
            vx: -2.76742510726862411e-03 * daysPerYear, vy: 4.99852801234917238e-03 * daysPerYear,
            vz: 2.30417297573763929e-05 * daysPerYear, mass: 2.85885980666130812e-04 * solarMass),
        Body(
            x: 1.28943695621391310e+01, y: -1.51111514016986312e+01, z: -2.23307578892655734e-01,
            vx: 2.96460137564761618e-03 * daysPerYear, vy: 2.37847173959480950e-03 * daysPerYear,
            vz: -2.96589568540237556e-05 * daysPerYear, mass: 4.36624404335156298e-05 * solarMass),
        Body(
            x: 1.53796971148509165e+01, y: -2.59193146099879641e+01, z: 1.79258772950371181e-01,
            vx: 2.68067772490389322e-03 * daysPerYear, vy: 1.62824170038242295e-03 * daysPerYear,
            vz: -9.51592254519715870e-05 * daysPerYear, mass: 5.15138902046611451e-05 * solarMass),
    ]
}

/// Gives the sun the momentum that keeps the system's center still.
fn offsetMomentum(bodies: [Body]) {
    var px = 0.0
    var py = 0.0
    var pz = 0.0
    for b in bodies {
        px += b.vx * b.mass
        py += b.vy * b.mass
        pz += b.vz * b.mass
    }
    let sun = bodies[0]
    sun.vx = -px / solarMass
    sun.vy = -py / solarMass
    sun.vz = -pz / solarMass
}

/// Returns the total kinetic and potential energy of the system.
fn energy(bodies: [Body]) -> float {
    var e = 0.0
    for i in 0..bodies.len {
        let b = bodies[i]
        e += 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
        for j in i + 1..bodies.len {
            let c = bodies[j]
            let dx = b.x - c.x
            let dy = b.y - c.y
            let dz = b.z - c.z
            e -= b.mass * c.mass / math.sqrt(dx * dx + dy * dy + dz * dz)
        }
    }
    return e
}

/// Moves the system forward by [dt].
fn advance(bodies: [Body], dt: float) {
    let n = bodies.len
    for i in 0..n {
        let b = bodies[i]
        for j in i + 1..n {
            let c = bodies[j]
            let dx = b.x - c.x
            let dy = b.y - c.y
            let dz = b.z - c.z
            let d2 = dx * dx + dy * dy + dz * dz
            let mag = dt / (d2 * math.sqrt(d2))
            b.vx -= dx * c.mass * mag
            b.vy -= dy * c.mass * mag
            b.vz -= dz * c.mass * mag
            c.vx += dx * b.mass * mag
            c.vy += dy * b.mass * mag
            c.vz += dz * b.mass * mag
        }
    }
    for b in bodies {
        b.x += dt * b.vx
        b.y += dt * b.vy
        b.z += dt * b.vz
    }
}

fn main() {
    let args = os.args()
    let steps = if args.isEmpty { 10_000_000 } else { int(args[0]) }
    let bodies = system()
    offsetMomentum(bodies)
    let before = energy(bodies)
    for _ in 0..steps {
        advance(bodies, 0.01)
    }
    println("nbody({steps}) = {before.toFixed(9)} {energy(bodies).toFixed(9)}")
}
