/// Regular expressions: finding, replacing and splitting text by a pattern.
///
/// [compile] turns a pattern into a [Regex]. Patterns follow the common
/// Perl style: the first alternative that matches wins, and repeats take
/// as much as they can unless a `?` after them makes them lazy. Matching
/// counts Unicode characters, and its time grows with the pattern's size
/// times the text's length, never exponentially.

extern fn cCompile(pattern: string) -> int as "vx_re_compile"
extern fn cError() -> string as "vx_re_error"
extern fn cName(pattern: string, group: int) -> string? as "vx_re_name"
extern fn cExec(pattern: string, text: string, from: int, whole: bool) -> bool as "vx_re_exec"
extern fn cCap(slot: int) -> int as "vx_re_cap"
extern fn cChars(text: string, offset: int) -> int as "vx_re_chars"
extern fn cSlice(text: string, from: int, to: int) -> string as "vx_re_slice"
extern fn cNext(text: string, offset: int) -> int as "vx_re_next"
extern fn cBytes(text: string) -> int as "vx_re_bytes"

/// Returns [pattern] compiled into a [Regex]. Throws an Error saying what
/// is wrong and where when the pattern isn't valid.
pub fn compile(pattern: string) throws -> Regex {
    let count = cCompile(pattern)
    if count < 0 {
        throw Error("can't compile the pattern '{pattern}': {cError()}")
    }
    var names: [string: int] = [:]
    for g in 1..=count {
        if let name = cName(pattern, g) {
            names[name] = g
        }
    }
    return Regex(pattern: pattern, groupCount: count, names: names)
}

/// Returns [text] with a backslash before each character that has a
/// meaning in patterns, so that it matches only itself.
pub fn escape(text: string) -> string {
    var out: [string] = []
    for c in text.chars() {
        if r"\^$.|?*+()[]{}".contains(c) {
            out.push("\\")
        }
        out.push(c)
    }
    return out.join("")
}

/// A compiled regular expression, made by [compile].
pub struct Regex {
    /// The pattern, as written.
    pub let pattern: string

    /// The number of groups in parentheses that capture.
    pub let groupCount: int

    names: [string: int]

    /// Reports whether the whole of [text] matches.
    pub fn matches(text: string) -> bool => cExec(pattern, text, 0, true)

    /// Reports whether some part of [text] matches.
    pub fn hasMatch(text: string) -> bool => cExec(pattern, text, 0, false)

    /// Returns the first match in [text], or nil when there is none.
    pub fn find(text: string) -> Match? {
        if !cExec(pattern, text, 0, false) {
            return nil
        }
        return captured(text)
    }

    /// Returns every match in [text], from the start, each beginning where
    /// the one before ended. After an empty match the search moves on by
    /// one character.
    pub fn findAll(text: string) -> [Match] {
        var out: [Match] = []
        var at = 0
        while cExec(pattern, text, at, false) {
            let m = captured(text)
            out.push(m)
            if m.byteEnd > m.byteStart {
                at = m.byteEnd
            } else {
                at = cNext(text, m.byteEnd)
                if at < 0 {
                    break
                }
            }
        }
        return out
    }

    /// Returns [text] with every match replaced by [with]. In [with], `$0`
    /// is the whole match, `$1` to `$9` and `$<12>` are groups by number,
    /// `$<name>` a group by name, and `$$` a dollar sign. A group that took
    /// no part gives an empty string; a reference to one that doesn't
    /// exist is kept as written.
    pub fn replace(text: string, with: string) -> string => replaceIn(text, with, findAll(text))

    /// Returns [text] with the first match replaced by [with], written as
    /// for [replace].
    pub fn replaceFirst(text: string, with: string) -> string {
        guard let m = find(text) else {
            return text
        }
        return replaceIn(text, with, [m])
    }

    fn replaceIn(text: string, template: string, found: [Match]) -> string {
        var parts: [string] = []
        var last = 0
        for m in found {
            parts.push(cSlice(text, last, m.byteStart))
            parts.push(expand(template, m))
            last = m.byteEnd
        }
        parts.push(cSlice(text, last, cBytes(text)))
        return parts.join("")
    }

    /// Returns the pieces of [text] between matches. An empty match at
    /// either end of the text, or right where the last piece ended, doesn't
    /// split, so an empty pattern splits text into its characters.
    pub fn split(text: string) -> [string] {
        var out: [string] = []
        var last = 0
        let n = cBytes(text)
        for m in findAll(text) {
            if m.byteStart == m.byteEnd && (m.byteStart == last || m.byteStart == n) {
                continue
            }
            out.push(cSlice(text, last, m.byteStart))
            last = m.byteEnd
        }
        out.push(cSlice(text, last, n))
        return out
    }

    /// Returns the pattern.
    pub fn toString() -> string => pattern

    /// Returns the match the last search found in [text].
    fn captured(text: string) -> Match {
        var groups: [string?] = []
        for g in 1..=groupCount {
            let a = cCap(2 * g)
            groups.push(if a < 0 { nil } else { cSlice(text, a, cCap(2 * g + 1)) })
        }
        let a = cCap(0)
        let b = cCap(1)
        return Match(
            text: cSlice(text, a, b),
            start: cChars(text, a),
            end: cChars(text, b),
            groups: groups,
            names: names,
            byteStart: a,
            byteEnd: b,
        )
    }

    /// Returns [template] with the references to groups filled in from [m].
    fn expand(template: string, m: Match) -> string {
        if !template.contains("$") {
            return template
        }
        let cs = template.chars()
        var out: [string] = []
        var i = 0
        while i < cs.len {
            let c = cs[i]
            i += 1
            if c != "$" || i >= cs.len {
                out.push(c)
                continue
            }
            let next = cs[i]
            if next == "$" {
                out.push("$")
                i += 1
            } else if next >= "0" && next <= "9" && next.len == 1 {
                let g = int(next)
                if g <= groupCount {
                    out.push(m.groupAt(g) ?? "")
                } else {
                    out.push("$" + next)
                }
                i += 1
            } else if next == "<" {
                var j = i + 1
                while j < cs.len && cs[j] != ">" {
                    j += 1
                }
                let ref = cs[(i + 1)..j].join("")
                let number = int.parse(ref)
                if j < cs.len && number != nil && (number ?? 0) <= groupCount {
                    out.push(m.groupAt(number ?? 0) ?? "")
                    i = j + 1
                } else if j < cs.len && names.contains(ref) {
                    out.push(m.group(ref) ?? "")
                    i = j + 1
                } else {
                    out.push("$")
                }
            } else {
                out.push("$")
            }
        }
        return out.join("")
    }
}

/// A part of a text that a [Regex] matched.
pub struct Match {
    /// The text matched.
    pub let text: string

    /// Where the match starts in the text searched, in characters.
    pub let start: int

    /// Where the match ends in the text searched, in characters.
    pub let end: int

    /// The text of each group in parentheses, from the first; nil for a
    /// group that took no part in the match.
    pub let groups: [string?]

    names: [string: int]
    byteStart: int
    byteEnd: int

    /// The characters of the text searched that matched, from [start] up
    /// to [end], to slice the text with.
    pub get range -> Range => start..end

    /// Returns the text of the group called [name], or nil when it took no
    /// part in the match or the pattern has no such group.
    pub fn group(name: string) -> string? {
        guard let g = names[name] else {
            return nil
        }
        return groups[g - 1]
    }

    /// Returns group [g], or the whole match for 0.
    fn groupAt(g: int) -> string? => if g == 0 { text } else { groups[g - 1] }

    /// Returns the match as `Match("text", 3..7)`.
    pub fn toString() -> string {
        let quoted = str([text])
        return "Match({quoted[1..(quoted.len - 1)]}, {start}..{end})"
    }
}
