/// Building and padding strings.

/// Returns [s] repeated [count] times.
pub fn repeat(s: string, count: int) -> string => s.repeat(count)

/// Returns [parts] joined with [separator] between them.
pub fn join(parts: [string], separator: string) -> string => parts.join(separator)

/// Returns [s] with [fill] added in front until it is [width] characters long.
pub fn padLeft(s: string, width: int, fill: string = " ") -> string => s.padStart(width, with: fill)

/// Returns [s] with [fill] added after it until it is [width] characters long.
pub fn padRight(s: string, width: int, fill: string = " ") -> string => s.padEnd(width, with: fill)
