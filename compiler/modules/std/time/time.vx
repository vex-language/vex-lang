/// Reading the clock.

/// Returns nanoseconds from a fixed point in the past. Only differences
/// between two readings mean something, which makes it right for measuring
/// how long code takes.
pub extern fn nanos() -> int as "vx_time_ns"

/// Returns the seconds since 1970-01-01 UTC.
pub extern fn unix() -> int as "vx_time_unix"

/// Returns a future that completes after [ms] milliseconds. `await sleep(500)`
/// pauses the async function it is in, while other tasks keep running.
pub extern fn sleep(ms: int) -> Future<void> as "vx_sleep"

// `timeout(future, ms)` is built into the compiler: it gives a future of the
// value as an optional, nil when [ms] milliseconds pass first, and cancels
// the late task.
