import "vex:time"

async fn echo<T>(x: T, ms: int) -> T {
    await time.sleep(ms)
    return x
}

enum Shape {
    circle(r: int)
    async fn area() -> int {
        await time.sleep(1)
        return match self {
            circle(r) => r * r * 3
        }
    }
    static async fn unit() -> Shape {
        return .circle(r: 1)
    }
}

struct Job {
    name: string
    result: Future<int>
}

fn start(name: string) -> Job {
    return Job(name: name, result: echo(name.len, 3))
}

fn total(fs: [Future<int>]) -> Future<[int]> {
    return all(fs)
}

fn run(x: int) -> int {
    return x + 1
}

async fn main() {
    println(await echo("hi", 2), await echo(4.5, 1))
    let s = await Shape.unit()
    println(await s.area(), await Shape.circle(r: 2).area())
    let jobs = [start("alpha"), start("be")]
    for j in jobs {
        println(j.name, await j.result)
    }
    println(await total([echo(1, 3), echo(2, 1)]))
    println(run(1))
    let fs: [Future<string>] = []
    println(await all(fs))
    let v: Future<void> = time.sleep(1)
    await v
    await v
    println("again fine")
}
