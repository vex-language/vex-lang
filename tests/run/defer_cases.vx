enum Shape {
    circle
    square
}

fn pick(s: Shape) -> int {
    match s {
        circle => {
            defer { println("arm cleanup") }
            return 1
        }
        square => return 2
    }
}

fn loopMatch() {
    outer: for i in 0..5 {
        match i {
            1 => continue outer
            3 => break outer
            _ => {
                defer { println("arm {i} left") }
                if i == 2 {
                    continue
                }
                println("arm {i}")
            }
        }
    }
}

fn closures() {
    let f = fn(n: int) -> int {
        defer { println("closure cleanup {n}") }
        if n > 1 {
            return n
        }
        return 0
    }
    println(f(5))
    each([1, 2]) { x in
        defer { println("each {x} done") }
        println("each {x}")
    }
}

fn nestedDefer() {
    defer {
        defer { println("inner of defer") }
        for i in 0..3 {
            if i == 1 { break }
            println("defer loop {i}")
        }
    }
    println("nestedDefer body")
}

fn main() {
    println(pick(Shape.circle))
    loopMatch()
    closures()
    nestedDefer()
}

fn each(xs: [int], body: fn(int)) {
    for x in xs {
        body(x)
    }
}
