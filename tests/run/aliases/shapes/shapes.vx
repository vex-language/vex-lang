/// A point on a grid.
pub struct Point {
    pub x: int
    pub y: int

    pub static fn origin() -> Point => Point(x: 0, y: 0)
}

pub enum Level { low, mid, high }

pub struct Box<T> { pub v: T }

pub typedef P = Point
pub typedef L = Level
pub typedef IntBox = Box<int>
pub typedef Grid<T> = [[T]]
