// An if used as a value.
enum Shape {
    circle(r: float)
    square(side: float)
    empty
}

struct Box<T> {
    value: T
}

fn pick<T>(first: bool, a: T, b: T) -> T => if first { a } else { b }

fn grade(score: int) -> string {
    return if score >= 90 { "A" } else if score >= 75 { "B" } else { "C" }
}

fn label(name: string?) -> string => if let n = name { "hi {n}" } else { "anonymous" }

async fn slow(x: int) -> int => x * 10

async fn run() -> int {
    let fast = true
    return if fast { await slow(2) } else { 0 }
}

async fn main() {
    let selected = true
    let color = if selected { "blue" } else { "gray" }
    println(color, grade(95), grade(80), grade(10))
    println(label("ann"), label(nil))
    let s = Shape.circle(r: 2.0)
    let area = if s case circle(r) { 3.0 * r * r } else if s case square(side) when side > 0.0 { side * side } else { 0.0 }
    println(area)
    let maybe: int? = if selected { 5 } else { nil }
    println(maybe ?? -1)
    println(1 + if selected { 10 } else { 20 } * 2)
    let names = [for i in 0..3 if i % 2 == 0 "even" else "odd"]
    println(names, [1, 2, 3].map(fn(x) => if x > 1 { "big" } else { "small" }))
    let f = fn(x: int) -> string => if x < 0 { panic("negative") } else { str(x) }
    println(f(4), await run())
    let k3 = 3
    println("{k3} {if k3 == 1 { "item" } else { "items" }}")
    let size = if k3 > 2 { if k3 > 5 { "large" } else { "medium" } } else { "small" }
    println(size)
    let who: string? = "zed"
    let greet = if let s = who { fn() => "hello {s}" } else { fn() => "nobody" }
    println(greet())
    println(pick(false, Box(value: [1]), Box(value: [2, 3])).value, pick(true, "x", "y"))
    var i = 0
    while if i < 3 { true } else { false } {
        i += 1
    }
    let parts = [for k in 0..4 if k > 0 str(if k % 2 == 0 { k * 100 } else { k })]
    println(i, parts)
    let m = ["a": 1]
    let v = if let x = m["a"] { x + 1 } else { 0 }
    println(v)
}
