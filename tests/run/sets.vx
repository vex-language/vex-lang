/// Sets: literals, members, set operations, loops, equality, JSON and
/// isolates.
import "vex:json"
import "vex:isolate"

struct Point: Hashable {
    x: int
    y: int
}

enum Color {
    red
    green
    blue
}

enum Shape: Hashable {
    circle(r: int)
    square(side: int)
}

struct Post: Codable, Equatable {
    title: string
    tags: Set<string> = []
}

const vowels: Set<string> = ["a", "e", "i", "o", "u"]

fn unique<T: Hashable>(items: [T]) -> Set<T> => Set(items)

fn evens(n: int) -> Set<int> => [for i in 0..n if i % 2 == 0 i % 4]

fn tag(post: Post, name: string) {
    post.tags.insert(name)
}

fn basics() {
    let primes: Set<int> = [2, 3, 5, 7]
    var seen = Set<string>()
    println(seen.insert("a"), seen.insert("a"), seen.len)
    println(seen.remove("a"), seen.remove("a"), seen.isEmpty)
    let s = Set([1, 2, 2, 1])
    println(s, s.len, s.isEmpty, s.contains(2), s.contains(3))
    println(primes.intersection([3, 4, 5]))
    println(primes.union(s), primes.subtracting([2, 7, 9]))
    let small = [2, 3]
    println(Set(small).isSubset(of: primes), primes.isSubset(of: small))
    println(primes == [7, 5, 3, 2], primes == s, primes != s)
    println(primes.toList(), "p: {primes}", str(Set<int>()))
}

fn order() {
    var s: Set<string> = ["b", "a", "c"]
    s.insert("a")
    s.remove("b")
    s.insert("b")
    for x in s {
        print(x, "")
    }
    println()
    // Items added during a loop aren't visited.
    var n = Set([1, 2, 3])
    for x in n {
        n.remove(x)
        n.insert(x + 10)
    }
    println(n)
}

fn elements() {
    let pts: Set<Point> = [Point(x: 1, y: 2), Point(x: 3, y: 4)]
    println(pts.contains(Point(x: 1, y: 2)), pts.contains(Point(x: 2, y: 1)), pts)
    let colors: Set<Color> = [.red, .blue]
    println(colors, colors.contains(.green))
    var shapes = Set<Shape>()
    shapes.insert(.circle(r: 1))
    shapes.insert(.circle(r: 1))
    shapes.insert(.square(side: 2))
    println(shapes.len, shapes)
    let pairs: Set<(int, string)> = [(1, "a"), (2, "b")]
    for (n, s) in pairs {
        println(n, s)
    }
}

fn values() throws {
    println(unique([3, 1, 3, 2, 1]), evens(7))
    println(vowels.contains("e"), vowels.len)
    var mine = vowels.copy()
    mine.insert("y")
    println(mine, vowels)
    let post = Post(title: "Sets")
    tag(post, "vex")
    tag(post, "vex")
    let text = json.encode(post)
    println(text)
    let back: Post = try json.decode(text)
    println(back.tags, back == post)
    let maybe: Set<int>? = [1]
    let none: Set<int>? = nil
    println(maybe, none)
    let nested = [Set([1]), Set([2, 3])]
    println(nested, nested == [Set([1]), Set([3, 2])])
    let copy = Set(primesOf(10))
    println(copy, copy === copy)
    let has = copy.contains
    println(has(5), has(4))
}

fn primesOf(n: int) -> Set<int> {
    var out = Set<int>()
    for i in 2..n {
        if !out.toList().any(fn(p) => i % p == 0) {
            out.insert(i)
        }
    }
    return out
}

async fn main() throws {
    basics()
    order()
    elements()
    try values()
    let back = await isolate.run(fn() -> Set<int> => [1, 2, 3])
    println(back)
}
