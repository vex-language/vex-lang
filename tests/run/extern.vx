// Calling C functions with extern fn.
import "vex:math"
import "vex:time"

extern fn strlen(s: string) -> int
extern fn getenv(name: string) -> string?
extern fn setenv(name: string, value: string, overwrite: int)
extern fn labs(x: int) -> int
extern fn atof(s: string) -> float
extern fn strstr(haystack: string, needle: string) -> string?

fn main() {
    // Strings cross as NUL-terminated copies; nil results come back as nil.
    println(strlen(""), strlen("héllo"), strlen("tab\there"))
    println(getenv("VEX_SURELY_UNSET_123"))
    setenv("VEX_TEST_VAR", "set from vex", 1)
    println(getenv("VEX_TEST_VAR") ?? "missing")
    println(labs(-42), atof("2.5") * 2.0)
    println(strstr("hello world", "wor") ?? "none", strstr("hello", "xyz") ?? "none")

    // C functions are values like any other.
    let measure: fn(string) -> int = strlen
    println(["a", "bb", "ccc"].map(strlen), measure("four"))

    // Float math comes from C.
    println(math.sqrt(2.0), math.sqrt(-1.0) != math.sqrt(-1.0), math.cbrt(27.0))
    println(math.powf(2.0, 10.0), math.exp(0.0), math.log(1.0), math.log2(8.0), math.log10(1000.0))
    println(math.floor(-2.5), math.ceil(-2.5), math.round(2.5), math.round(-2.5), math.trunc(-2.7), math.absf(-3.25))
    println(math.sin(0.0), math.cos(0.0), math.atan2(1.0, 1.0) * 4.0 == math.pi(), math.hypot(3.0, 4.0))
    println(math.asin(1.0) * 2.0 == math.pi(), math.acos(1.0), math.atan(0.0), math.tan(0.0))
    println([0.0, 1.0, 4.0].map(math.sqrt))

    let start = time.nanos()
    var sum = 0.0
    for i in 0..100000 {
        sum += math.sqrt(float(i))
    }
    println(sum > 21000000.0, time.nanos() >= start, time.unix() > 1700000000)
}
