interface Shape {
    fn area() -> float
}

struct Holder: Equatable {
    shape: Shape
}

struct Cell: Hashable {
    ratio: float
    action: fn()
}

struct Loose: Hashable {
    name: string
    operator ==(other: Loose) -> bool => name == other.name
}

struct BadHash: Hashable {
    id: int
    fn hash(seed: int) -> int => seed
}

struct Box<T>: Equatable {
    item: T
}

struct Plain {
    v: int
}

enum Tree: Equatable {
    leaf
    node(children: [Holder])
}

fn main() {
    let a = Plain(v: 1)
    let same = a == Plain(v: 1)
    let n = 1
    let ref = n === 1
    let mixed = a === [1]
    var m: [Plain: int] = [:]
    let h = hash(a)
    let fs = [fn() {}]
    let eq = fs == fs
}

