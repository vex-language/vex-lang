/// Misused Bytes: wrong arguments, values that aren't bytes and missing
/// members.
fn main() {
    let a = Bytes("hi")
    let b = Bytes(size: 3)
    let c = Bytes([1.5])
    let d = Bytes(1, 2)
    var e = Bytes(count: "3")
    e.push("x")
    e[0] = "y"
    e[0..1] = Bytes()
    let f: int = e[0..1]
    println(e.size, e.decode(), Bytes.fromBase64("x"), e < e)
    let g = Bytes
    for x in e {
        let s: string = x
    }
    let h = e + e
    e.append([1])
    let u: Bytes = Bytes.fromHex("00")
}

