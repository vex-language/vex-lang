// Mistakes with the string members.
fn main() {
    let s = "a,b"
    println(s.isEmpty())
    let n: int = s.count
    if s.count > 1 {}
    println(s.count())
    println(s.split(",", limit: "2"))
    println(s.split(",", max: 2))
    println(s.padStart("3"))
    println(s.padEnd(3, with: 0))
    println(s.reversed(1))
    println(s.capitalise())
    println(s.repeat())
    println(s.lastIndexOf(1))
    println(s.length)
}

