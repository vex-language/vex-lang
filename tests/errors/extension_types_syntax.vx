extension type Empty()
extension type Pair(a: int, b: int)
extension type Untyped(value)
extension type Defaulted(value: int = 0)
extension type NoParens: Equatable
extension type WithField(value: int) {
    extra: int
}
extension type WithInit(value: int) {
    init {
        println(value)
    }
}
extension type WithSetter(value: int) {
    set double(v: int) {}
}

