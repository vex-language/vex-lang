interface Named {
    fn name() -> string
}

extension type UserId(value: int) {
    fn isAdmin() -> bool => value < 100
}

extension type Shown(value: int): Named {
    fn name() -> string => "shown"
}

extension type Loop(value: Loop?)
extension type Tags(value: [string]): Comparable
extension type Plain(value: [int])
extension type Bad<T>(value: T): Comparable
extension type Deep(value: (Deep?, int))
extension type UserId(value: string)

fn load(id: UserId) {}

fn main() {
    load(42)
    let id = UserId(value: 7)
    let n: int = id
    let m: int = UserId(value: 1)
    id.value = 3
    println(id + 1)
    println(id.abs())
    println(id < UserId(value: 2))
    println(Plain(value: []) == Plain(value: []))
    let p = Plain(value: [])
    println(p === p)
    let named: Named = Shown(value: 1)
    let ids: [UserId] = [1]
    let seen: [Plain: bool] = [:]
    let shape: Named = Shown(value: 2)
    if shape is Shown {}
}

