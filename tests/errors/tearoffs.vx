// Mistakes with tear-offs.
struct User {
    name: string
    fn greet(other: string) -> string => "hi {other}"
    async fn load() -> int => 1
    fn pick<T>(x: T) -> T => x
    static fn make() -> fn(string) -> string => greet
}

struct Box<T> {
    value: T
    static fn empty() -> int => 0
    fn emptyFn() -> fn() -> int => empty
}

enum Shape {
    circle(radius: float)
    dot
}

extension<T> [T] {
    fn second() -> T => self[1]
}

fn main() {
    let u = User(name: "a")
    let a = User.greet
    let b = u.load
    let c = u.pick
    let d = Box.new
    let e: fn(int, int) -> Box<int> = Box.new
    let f: fn(int) -> string = u.greet
    let g: Shape = .circle
    let h = [1].map
    let i: fn() -> string = [1].second
}
