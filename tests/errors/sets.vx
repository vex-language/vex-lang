/// Misused sets: items that can't be hashed, wrong items and members.
struct P {
    x: int
}

const small: Set<int> = [1, 2]

fn main() {
    let a: Set<float> = [1.5]
    let b: Set<P> = []
    let c: Set = [1]
    let d = Set<int, string>()
    let e = Set()
    let f: Set<int> = [1, 2, 1]
    var s = Set([1, 2])
    s.add(3)
    s.insert("x")
    println(s.union(["a"]), s.intersection(5), s.isSubset([1]), s.subtracting(other: [1]))
    println(s[0], s.size, s.len())
    for i, x in s { }
    small.insert(3)
    let g = Set(1, 2)
    let h = Set([1.5])
    let xs = [1]
    println(s == xs, s < s)
}

