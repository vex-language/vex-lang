import "../ext"

fn hidden() {}

pub struct Point {
    pub x: int
    y: int = 0

    static fn origin() -> Point => Point(x: 0)
    fn secret() -> int => y
    get hidden -> int => y
    set hidden(v: int) { y = v }
    pub get shown -> int => y
}

struct Secret {
    v: int
}

pub struct Wall {
    pub h: int
    secret: int
}

pub fn make() -> int => 1

pub fn broken() -> int => "no"

typedef Hidden = int
pub typedef Grid<T> = [[T]]
pub typedef Pt = Point

extension string {
    fn libQuiet() -> string => lower()
}

pub struct Cash {
    pub cents: int
    operator -(other: Cash) -> Cash => other
}


pub struct Account {
    pub private(set) balance = 0
    pub let owner: string = "nobody"
    secret = 1

    pub fn deposit(n: int) { balance += n }
}

