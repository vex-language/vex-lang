// Mistakes with the list members.
struct Plain {
    v: int
}

fn main() {
    let ps = [Plain(v: 1)]
    var nums = [3, 1, 2]
    ps.sort()
    let a = ps.sorted()
    println(ps.min(), ps.indexOf(Plain(v: 1)))
    println(["a"].sum(), nums.first(), nums.isEmpty())
    nums.sort(by: fn(a, b) => a)
    let b = nums.reduce(0, fn(s, x) => "x")
    let c = nums.flatMap(fn(x) => x)
    let d = nums.map
    nums.insert("x", at: 0)
    let e: int = nums.first
}

