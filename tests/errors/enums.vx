// Enums and match.

enum Shape {
    circle(radius: float)
    rect(width: float, height: float)
    empty
}

enum Dir { up, down }

fn main() {
    let a = Shape.circel(radius: 1)
    let b = Shape.circle
    let c = .empty
    let s = Shape.empty
    println(s.radius)
    match s {
        empty => println(0)
    }
    match s {
        rect(w) => println(w)
        _ => println(1)
        circle(r) => println(r)
    }
    let n = match 3 {
        1 => "one"
        _ => 2
    }
    match 1.5 {
        0.0..1.0 => println(0)
    }
    let same = s == Shape.empty
}


