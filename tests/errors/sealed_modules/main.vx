import "lib"

struct Mine: lib.Result {}

interface More: lib.Result {}

struct Fine: lib.Plain {}

struct Sneaky: lib.Wider {}

fn show(r: lib.Result) -> string => match r {
    o: lib.Ok => "{o.value}"
}

fn main() {}

