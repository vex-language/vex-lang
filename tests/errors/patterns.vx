struct Point {
    x: int
    y: int
}

enum Shape {
    circle(radius: int)
    rect(width: int, height: int)
}

fn main() {
    let p = Point(x: 1, y: 2)
    let s = Shape.circle(radius: 1)
    let a = match p {
        Point(x: 0, :y) => y
    }
    let b = match s {
        circle(r) when r > 1 => r
        rect(w, _) => w
    }
    let c = match (1, true) {
        (_, true) => 1
        (0, _) => 2
    }
    let d = match [1, 2] {
        [] => 0
        [x, ...] => x
        [x, y] => y
    }
    let e = match 5 {
        1..=9 => 1
        5 => 2
        _ => 3
    }
    let f = match p {
        Point(z: 1) => 1
        Point(1, 2) => 2
        _ => 3
    }
    let g = match (1, 2) {
        (x, 0) || (0, y) => 1
        _ => 2
    }
    let h = match s {
        circle(radius: r, radius: q) => r
        _ => 0
    }
    let [one, two] = [1, 2]
    let (n, n) = (1, 2)
    let i = match 5 {
        9..1 => 1
        _ => 2
    }
    let j = match "a" {
        "a"..="z" => 1
        _ => 2
    }
    if s case rect(w, h) when w {
        println(w)
    }
    let k = match s {
        circle(r) => r
        rect(w, _) => w
        circle(_) => 0
    }
}

