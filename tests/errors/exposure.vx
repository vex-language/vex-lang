struct Secret {
    v: int
}

enum Mode {
    fast
    slow
}

interface Hidden {}

typedef Ids = [int]

pub fn make() -> Secret => Secret(v: 1)
pub fn take(s: [Secret?]) {}
fn fine() -> Secret => Secret(v: 2)

pub struct Car {
    pub mode: Mode
    spare: Mode = Mode.fast

    pub fn secret() -> Secret => Secret(v: 3)
    fn quiet() -> Secret => Secret(v: 4)
}

pub enum Shape {
    blob(s: Secret)
}

pub interface Shown: Hidden {
    fn ids() -> Ids
}

pub typedef Pair = (Secret, Secret)

struct Private {
    pub s: Secret
}

fn main() {}

