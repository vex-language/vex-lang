// Repeated values written differently, and types that take no arguments.
extern type H
extern fn g(x: float32?) -> int
const ten = 10

fn f<T>(h: H<int>, x: T<int>) {}

export fn vex_release() {}

fn main() {
    let x = 1
    let a = match x { 1 => "a", 0x1 => "b", _ => "c" }
    let b = match x { 10 => "a", ten => "b", 1_0 => "c", _ => "d" }
    let c = match x { -1 => "a", -0x1 => "b", 0 => "c", -0 => "d", _ => "e" }
    let m = [10: "a", 0b1010: "b"]
}

// error: 3:16: float32? can't cross into C, since a C number has no nil
