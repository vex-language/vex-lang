import "vex:os"

fn main() {
    if os.target == .windows {
        let n: int = "not checked away"
    }
    if os.target == "macos" {
        println("x")
    }
    let name = match os.target {
        macos => "mac"
        linux => "linux"
    }
    if os.arch == .x86 {
        println(name)
    }
    os.target = .linux
}

