async fn fetch() -> int => 1

interface Repo {
    async fn find(id: int) -> int
}

struct SyncRepo: Repo {
    fn find(id: int) -> int => id
}

fn plain() -> int => 2

fn main() {
    let f: fn() -> int = fetch
    let g: async fn() -> int = plain
    let h = fn() {
        let x = await fetch()
    }
    let a = async fn() -> int => await fetch()
    let n: int = a()
    let w = run(a())
    let k = [fetch, plain]
}

