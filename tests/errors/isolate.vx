import "vex:isolate"
import "vex:time"
interface Shape {
    fn area() -> int
}
struct Job {
    done: fn() -> int
}
fn work() -> int => 1
fn add(a: int) -> int => a
fn main() {
    let cb = fn() -> int { return 1 }
    let f = isolate.run(fn() -> int { return cb() })
    let job = Job(done: work)
    let g = isolate.run(fn() -> int { return job.done() })
    let h = isolate.run(add)
    let k = isolate.run(cb)
    let c1 = Channel<fn()>()
    let c2: Channel<Future<int>> = Channel()
    let c3 = Channel()
    let c4 = Channel<int>(5)
    let r = isolate.run(fn() -> Future<void> { return time.sleep(1) })
    isolate.spawn(fn() throws { throw Error("x") })
    let s: Shape? = nil
    let t = isolate.run(fn() -> int { return s?.area() ?? 0 })
    let ch = Channel<int>()
    ch.send("x")
    let v: string? = ch.receiveSync()
}

