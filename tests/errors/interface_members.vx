interface Make {
    static fn make() -> Self
    static fn other() -> int => 1
}

interface Same {
    fn same(other: Self) -> bool
    fn differ(other: Self) -> bool => !same(other: other)
    fn check() -> bool => same(other: self)
}

interface Each {
    fn each<U>(f: fn(int) -> U) -> [U]
}

struct A: Make {
    fn make() -> A => A()
}

struct B: Make, Each {
    static fn make() -> int => 1
    fn each(f: fn(int) -> int) -> [int] => []
}

fn useMake<T: Make>() -> T {
    let x = T.missing()
    let y = T.make()
    return y
}

fn values(m: Make, xs: [Same]) {}

interface Shape {
    fn area() -> float
}

extension Shape {
    fn area() -> float => 1.0
    fn big() -> bool => area() > 9.0
    get size -> int => 1
    static fn unit() -> int => 1
}

extension Shape {
    fn big() -> bool => false
}

struct Sq: Shape {
    fn area() -> float => 4.0
    fn big() -> bool => true
}

fn top() -> Self {}

fn main() {}

