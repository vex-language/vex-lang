// Mistakes with the map helpers.
const limits = ["a": 1]

fn main() {
    var ages = ["ann": 31]
    println(ages.isEmpty(), ages.entries())
    ages.getOrPut("bob") { "x" }
    ages.getOrPut(1) { 2 }
    ages.update("ann") { "old" }
    let a = ages.filter { k, v in v }
    let b = ages.mapValues { k, v in v }
    let c = ages.mapValues { ages["zoe"] }
    let d = ages.mapValues
    let e = ages.mapValues()
    let f = ages.mapValues { println(it) }
    limits.getOrPut("b") { 2 }
    limits.update("a") { it + 1 }
    ages.putIfAbsent("cat", 3)
    let g: int = ages.update("ann") { it + 1 }
    let h = ages.entrys
}

