interface Named {
    get name -> string
    set name(value: string)
}

struct User: Named {
    let name: string
    let id: int

    fn rename() {
        name = "x"
    }
}

struct Counter {
    private(set) count = 0
}

struct Early {
    let size: int
    let twice: int

    init {
        println(size)
        show()
        size = 1
        twice = size * 2
    }

    fn show() {}
}

struct Loop {
    other = Loop()
}

struct Empty {
    nothing = nil
}

struct Later {
    let at: int

    init {
        let f = fn() {
            at = 3
        }
        f()
    }

    fn init() {}
}

fn main() {
    let u = User(name: "a", id: 1)
    u.id = 2
    let c = Counter()
    c.count = 3
    c.count += 1
    let e = Early()
    let missing = Early(size: 1)
    println(u, e, missing)
}

fn risky() throws -> int => 1

struct Strict {
    xs = []
    n = 0

    init {
        if n < 0 {
            throw Error("negative")
        }
        let k = try risky()
    }
}

