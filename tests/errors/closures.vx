// Closures and function values.

fn apply(f: fn(int) -> int, x: int) -> int => f(x)

fn onTap(handler: fn()) {
    handler()
}

fn main() {
    let unknown = fn(x) => x
    apply(fn(a, b) => a, 1)
    apply(fn(x) => "text", 1)
    let f = fn(x: int) => x
    f()
    f(x: 1)
    onTap(fn() {}) {}
    let n = 1
    n()
    for i in 0..3 {
        let g = fn() { break }
    }
}


// Expected errors:
