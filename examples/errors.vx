enum LoadError {
    notFound(path: string)
    denied
}

fn parsePort(s: string) throws -> int {
    if s == "" {
        throw Error("empty port")
    }
    let n = int(s)
    if n < 1 || n > 65535 {
        throw Error("port {n} out of range")
    }
    return n
}

fn open(path: string) throws(LoadError) -> string {
    if path == "secret" {
        throw .denied
    }
    if path != "app.cfg" {
        throw .notFound(path: path)
    }
    return "8080"
}

fn load(path: string) throws -> int {
    let text = try open(path)
    return try parsePort(text)
}

struct Server {
    port: int

    fn start() throws {
        if port == 0 {
            throw Error("no port")
        }
        println("listening on {port}")
    }
}

fn twice(f: fn(int) throws -> int, x: int) throws -> int => try f(try f(x))

fn main() throws {
    println(try load("app.cfg"))
    let a = try load("x.cfg") catch e {
        println("failed: {e.message}")
        0
    }
    println(a)
    let b = try open("secret") catch e {
        match e {
            notFound(p) => "missing {p}"
            denied => "denied"
        }
    }
    println(b)
    let c = try? parsePort("70000") ?? 1
    let d = try? parsePort("22")
    println(c, d)
    for s in ["1", "", "3"] {
        let n = try parsePort(s) catch {
            continue
        }
        print(n, "")
    }
    println()
    try Server(port: 9).start()
    try Server(port: 0).start() catch e {
        println("server: {e.message}")
    }
    let half = fn(x: int) throws -> int {
        if x % 2 == 1 {
            throw Error("odd {x}")
        }
        return x / 2
    }
    println(try twice(half, 12))
    println(try twice(half, 6) catch e { println(e.message); -1 })
    println(try twice(fn(x) => x + 1, 1))
}
